# Copy to /etc/eduflow/backend.env, owner root:eduflow mode 0640.
# Replace every placeholder. Do not use shell 'export' in systemd env files.
DB_URL=jdbc:mysql://DB_HOST:3306/DB_NAME?sslMode=VERIFY_IDENTITY
DB_USERNAME=REPLACE_WITH_RUNTIME_USER
DB_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_BASE64_KEY
JWT_EXPIRATION_SECONDS=3600
FRONTEND_ORIGINS=https://erp.example.invalid
FILE_STORAGE_DIR=/var/lib/eduflow/files
MAX_UPLOAD_BYTES=10485760
DB_POOL_SIZE=10
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
# Academic and financial timezone is currently restricted to Asia/Kolkata.
TZ=Asia/Kolkata

# Include in http {}. Configure real certificates before nginx -t/reload.
limit_req_zone $binary_remote_addr zone=eduflow_auth:10m rate=10r/m;
server {
    listen 80;
    server_name erp.example.invalid;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name erp.example.invalid;
    ssl_certificate /etc/letsencrypt/live/erp.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/erp.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/eduflow/current/frontend;
    index index.html;
    client_max_body_size 101m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location ~ ^/api/auth/(login|register|password-reset/request|password-reset/confirm)$ {
        limit_req zone=eduflow_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
    # There is deliberately no static mapping to /var/lib/eduflow/files.
}
